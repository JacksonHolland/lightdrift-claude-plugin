            "description": "Subscription plans, monthly credits and the credit rule (1 credit per 10 results, rounded up, minimum 1).",
            "content": {
              "application/json": {
                "example": {
                  "version": "2026-09-28",
                  "currency": "USD",
                  "credits": {
                    "results_per_credit": 10,
                    "minimum_per_search": 1,
                    "asset_lookup_credits": 0,
                    "reset": "monthly on your billing date; unused credits do not roll over"
                  },
                  "plans": [
                    {
                      "id": "free",
                      "name": "Free",
                      "monthly_usd": 0,
                      "annual_usd": null,
                      "monthly_credits": 500,
                      "image_search": false,
                      "similar_search": false,
                      "max_results": 10,
                      "limits": {
